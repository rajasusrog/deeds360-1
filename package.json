{
  "name": "applet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx node_modules/vite/bin/vite.js --host 0.0.0.0 --port 3000",
    "build": "npm run typecheck && vite build",
    "lint": "tsc --noEmit",
    "typecheck:frontend": "tsc --noEmit",
    "typecheck:backend": "tsc -p tsconfig.backend.json --noEmit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.backend.json --noEmit",
    "preview": "vite preview",
    "start": "node --import tsx server.ts",
    "test": "node scripts/verify.mjs",
    "test:browser": "node --import tsx scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "@google/genai": "latest",
    "@supabase/supabase-js": "^2.112.3",
    "@types/jsdom": "^30.0.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "dompurify": "^3.4.17",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase": "^12.16.0",
    "jsdom": "^30.1.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.395.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "html2canvas-pro": "2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.2.2",
    "playwright-core": "1.64.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
